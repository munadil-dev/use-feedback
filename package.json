{
  "name": "use-feedback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "prisma generate",
    "migrate:dev": "dotenv -e .env.local -- pnpm dlx prisma migrate dev",
    "prisma:generate": "dotenv -e .env.local -- pnpm dlx prisma generate",
    "prisma:studio": "dotenv -e .env.local -- pnpm dlx prisma studio",
    "db:push": "dotenv -e .env.local -- pnpm dlx prisma db push",
    "db:seed": "dotenv -e .env.local -- pnpm dlx prisma db seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.4.2",
    "@prisma/client": "7.4.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@uploadcare/react-uploader": "^1.13.0",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.1",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.20",
    "next-themes": "^0.3.0",
    "react": "^18",
    "react-dom": "^18",
    "react-spinners": "^0.17.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-tweet": "^3.3.0",
    "recoil": "^0.7.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.8",
    "husky": "^9.1.7",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.4.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  }
